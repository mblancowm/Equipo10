    "db:setup": "bun src/db/migrate.ts && bun src/db/seed.ts"
  },
  "dependencies": {
    "@equipo10/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  }
}