{
  "name": "@equipo10/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "bun src/db/migrate.ts",
